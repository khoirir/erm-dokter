APP_ENV=development
APP_PORT=8082
APP_NAME=erm-dokter

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Secret key untuk JWT token (gunakan string random yang panjang, misal: openssl rand -hex 32)
JWT_SECRET=
USER_KEY=
PASSWORD_KEY=

# Key untuk enkripsi no_rawat di URL (gunakan string random yang panjang)
ENCRYPTION_KEY=

# CORS: origin yang diizinkan (* untuk semua, atau spesifik misal: http://localhost:3000)
CORS_ORIGIN=*

# Batas maksimal waktu edit/hapus rekam medis (dalam jam, default: 48)
MAX_EDIT_REKAM_MEDIS_JAM=48

