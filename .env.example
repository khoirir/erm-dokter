APP_ENV=development
APP_PORT=8082
APP_NAME=erm-dokter

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Secret key untuk JWT token (gunakan string random yang panjang, misal: openssl rand -hex 32)
JWT_SECRET=
USER_KEY=
PASSWORD_KEY=

# Key untuk enkripsi no_rawat di URL (gunakan string random yang panjang)
ENCRYPTION_KEY=

# API Key untuk integrasi aplikasi eksternal (Machine-to-Machine / M2M)
SERVICE_API_KEY=

# CORS: origin yang diizinkan (* untuk semua, atau spesifik misal: http://localhost:3000)
CORS_ORIGIN=*

# Batas maksimal waktu edit/hapus rekam medis (dalam jam, default: 48)
MAX_EDIT_REKAM_MEDIS_JAM=48

# URL server webapps berkas digital Khanza (untuk streaming PDF/gambar)
URL_BERKAS_DIGITAL=http://192.168.30.24/webapps/berkasrawat/

# Kode berkas digital laboratorium (pisahkan koma jika lebih dari satu)
# Referensi:
# 005: BERKAS LAB RUJUKAN
# 010: BERKAS LAB MIKROBIOLOGI
# 015: PATOLOGI ANATOMI
KODE_BERKAS_LAB_PK=005
KODE_BERKAS_LAB_PA=015
KODE_BERKAS_LAB_MB=010
